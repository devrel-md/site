{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devrel.md/schema/frontmatter.schema.json",
  "title": "DEVREL.md frontmatter",
  "type": "object",
  "required": ["spec", "product", "stage", "updated"],
  "properties": {
    "spec": {
      "type": "string",
      "pattern": "^devrel\\.md/0\\.[0-9]+$",
      "description": "The spec version this file follows, e.g. devrel.md/0.1"
    },
    "product": { "type": "string", "minLength": 1 },
    "url": {
      "anyOf": [{ "type": "string", "format": "uri" }, { "const": "unknown" }]
    },
    "stage": {
      "enum": ["pre-launch", "early", "growth", "scale", "enterprise", "unknown"]
    },
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "owner": { "type": "string" }
  },
  "additionalProperties": true
}
