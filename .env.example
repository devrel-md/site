# Copy to .env.local for local values (git ignores it). Maintainers inject these
# with `infisical run --env=dev -- npm run dev` instead. Never put real secrets
# in this file.
#
# Every variable has a local fallback (lib/env.ts). In production (NODE_ENV=production,
# at runtime, not during `next build`) the ones marked "Required in production" are
# checked by lib/configCheck.ts: if one is missing, empty or still the development
# value shown here, start-up logs it, /healthz reports `config: invalid` with the
# names, and the deploy job fails after going live. Resend and Folk are optional.

# Required in production. Postgres 16 connection string. Locally, any Postgres
# you run yourself (see README, Setup). Keep the database name devrelmd, which
# db:reset requires.
DATABASE_URL=postgres://devrelmd:<password>@localhost:5432/devrelmd

# Required in production. OpenRouter key used for the generator's model calls.
# Production uses its own key with its own credit limit, separate from the dev key.
OPENROUTER_API_KEY=

# Optional. Resend transactional email. Leave unset locally: the app logs instead of sending.
# Community audience sync (RESEND_AUDIENCE_ID) needs a full-access API key.
# Without it, consent is stored in Postgres but no audience sync occurs.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
EMAIL_FROM="DEVREL.md <hello@devrel.md>"
# Where replies to site emails go. Sending uses mail.devrel.md, which does not receive mail.
EMAIL_REPLY_TO="hello@devrel.md"

# Optional. Sync explicitly opted-in community contacts to Folk, into a group named "DEVREL.md community" (create it in Folk first).
FOLK_API_KEY=

# Required in production, with real keys. Cloudflare Turnstile. Use Cloudflare's documented always-pass test keys locally:
# site key 1x00000000000000000000AA, secret key 1x0000000000000000000000000000000AA
# Infisical names the secret TURNSTILE_SITE_SECRET; TURNSTILE_SECRET_KEY also
# works, as a fallback for the brief's original naming. In production a test secret
# fails closed: every Turnstile check is refused, so neither the generator nor
# community signup can be used.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SITE_SECRET=1x0000000000000000000000000000000AA

# Required in production. Salt used to hash IPs before storing them: sha256(ip + IP_HASH_SALT). Any random
# string locally; a real secret in production.
IP_HASH_SALT=local-dev-salt

# How many reverse proxies we run in front of the app, each appending the peer
# address to X-Forwarded-For. The client IP used for rate limiting is the entry
# that many places from the right; anything further left is client-controlled and
# ignored. Production is 1: the OpenShip OpenResty edge, which sets
# X-Forwarded-For to $proxy_add_x_forwarded_for. Use 2 if another proxy or CDN
# ever sits in front of the edge and does not replace the client address. 0 means
# no trusted proxy, so every request counts as an unknown address. Locally there is
# no proxy, so requests are unknown and share a small daily budget.
TRUSTED_PROXY_HOPS=1
# Production is behind Cloudflare and then the OpenShip edge, so it runs with 2 (since 7 Oct 2026).

# Stop paid generation once today's OpenRouter spend passes this, in US dollars.
DAILY_SPEND_CAP_USD=2.00

# Set by CI/deploy. Used by /healthz. Falls back to "dev" locally.
GIT_COMMIT_SHA=dev

# Required in production, as an https URL. Public origin of the site, used to build absolute links in emails and redirects.
SITE_URL=http://localhost:3000
