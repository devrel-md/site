# Copy to .env.local for ad-hoc local overrides, but the normal way to run this
# app locally is `infisical run --env=dev -- npm run dev`, which injects these
# from the devrel.md Infisical project. Never put real secrets in this file.

# Postgres connection string. There is no local Postgres for this project: dev
# Postgres runs in a dedicated container on the home server (porg), reachable
# over the tailnet, and its URL lives in Infisical (dev env). Do not run
# Postgres in Docker on this machine.
DATABASE_URL=

# OpenRouter key used for the generator's model calls.
OPENROUTER_API_KEY=

# Resend transactional email. Leave unset locally: the app logs instead of sending.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
EMAIL_FROM="DEVREL.md <hello@devrel.md>"

# Folk CRM push for qualified, opted-in leads. Leave unset locally: the app logs
# instead of pushing, and queues the push for retry.
FOLK_API_KEY=

# Cloudflare Turnstile. Use Cloudflare's documented always-pass test keys locally:
# site key 1x00000000000000000000AA, secret key 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Salt used to hash IPs before storing them: sha256(ip + IP_HASH_SALT). Any random
# string locally; a real secret in production.
IP_HASH_SALT=local-dev-salt

# Shared secret required as a bearer token on /api/cron/outbox.
CRON_SECRET=local-dev-cron-secret

# Stop paid generation once today's OpenRouter spend passes this, in US dollars.
DAILY_SPEND_CAP_USD=2.00

# Master switch for the 5-email failing-gate series. Off until Marcos approves copy.
SERIES_ENABLED=false

# Set by CI/deploy. Used by /healthz. Falls back to "dev" locally.
GIT_COMMIT_SHA=dev

# Public origin of the site, used to build absolute links in emails and redirects.
SITE_URL=http://localhost:3000
